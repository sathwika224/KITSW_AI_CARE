# KITSW AI CARE - SMTP configuration
# Copy this file to .env and replace the placeholders.
# Gmail requires a Google App Password, not your normal Gmail password.
KITSW_SMTP_HOST=smtp.gmail.com
KITSW_SMTP_PORT=587
KITSW_SMTP_USER=your-email@gmail.com
KITSW_SMTP_PASSWORD=your-16-character-app-password
KITSW_FROM_EMAIL=your-email@gmail.com
